{
  "name": "@infinitylib/infinity-theme",
  "version": "0.1.0",
  "description": "A CSS-first design token and component theme. No build, no framework.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/InfinityLib/infinity-theme.git"
  },
